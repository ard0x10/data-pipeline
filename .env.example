# Copy to .env and fill in before running the pipeline locally.
# Every value below is read at runtime; none of them have safe defaults in prod.

# Base URL of the source API. Paths from config/schedule.yaml are appended to it.
SOURCE_API_URL=https://api.internal/v1

# libpq connection string for the reporting warehouse.
WAREHOUSE_DSN=postgresql://pipeline:pipeline@localhost:5432/warehouse

# Root log level: DEBUG also prints one line per inserted batch.
LOG_LEVEL=INFO
